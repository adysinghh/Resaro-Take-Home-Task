HF_TOKEN=YOUR_TOKEN
HF_MODEL_ID=microsoft/phi-2
LLM_PROVIDER=hf   # hf | mock

# secguard integration
# policy file used by src/resaro_agent/security.py
RESARO_SECGUARD_POLICY=src/secguard/policies/security.yaml

# PromptGuard is ON by default.
# set to 0 to disable (for faster/fully deterministic local runs).
RESARO_ENABLE_PROMPTGUARD=1
